   "flag": ""
  },
  {
   "id": "srt:M048_1:187",
   "src_sha1": "b1804a4fdfcf",
   "ko": "설마, 알폰스 님……@n저를 쫓아서 이런 설국까지……?!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M048_1:188",
   "src_sha1": "a513ce243165",
