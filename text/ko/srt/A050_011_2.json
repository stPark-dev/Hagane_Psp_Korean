   "ko": "!!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A050_011_2:45",
   "src_sha1": "c8b517aa99da",
   "ko": "……차는 아직인가?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A050_011_2:47",
   "src_sha1": "a26ee1a49637",
