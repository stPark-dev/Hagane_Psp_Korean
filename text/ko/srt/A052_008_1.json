  {
   "id": "srt:A052_008_1:14",
   "src_sha1": "a408b76b701c",
   "ko": "…….@n⊥@n……여긴 사람이 잔뜩 있네~.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A052_008_1:15",
