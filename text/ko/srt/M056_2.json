   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M056_2:72",
   "src_sha1": "95086d3244a1",
   "ko": "이제 어느 쪽이든 상관없어.@n귀찮으니까 그리린!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M056_2:74",
   "src_sha1": "c32ef35d7f2d",
