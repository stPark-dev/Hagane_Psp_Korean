   "flag": ""
  },
  {
   "id": "srt:A016_014_3:18",
   "src_sha1": "c3b36124b2f5",
   "ko": "근데 엄청난 폭발이었네…….@n……이거, 타 죽었겠죠?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A016_014_3:19",
   "src_sha1": "d0b324469063",
