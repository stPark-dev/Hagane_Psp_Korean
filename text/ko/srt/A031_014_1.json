{
 "source": "A031_014_1",
 "entries": [
  {
   "id": "srt:A031_014_1:9",
   "src_sha1": "4d90c9ff8bf1",
   "ko": "…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:24",
   "src_sha1": "68a40018c212",
   "ko": "실례하겠습니다, 대령님.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:25",
   "src_sha1": "6a93ea8f6008",
   "ko": "중위……@n이런 데 와도 괜찮은 건가?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:26",
   "src_sha1": "6f78f856951f",
   "ko": "북방사령부로 전근된@n펄만 준위에게서 맡은 물건을@n전해 드리러 왔습니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:28",
   "src_sha1": "3bedf64cc5c7",
   "ko": "……감시의 눈도 있을 텐데,@n굳이 자네가 전해 주지 않아도.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:30",
   "src_sha1": "5adee2cecb12",
   "ko": "……이겁니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:42",
   "src_sha1": "cd8399a5b413",
   "ko": "‘66 사건’ 때 펄만이 은신처에@n틀어박혀 있을 때 빌려줬던 체스판……@n⊥@n그때는 자네가 있어 줘서 살았지.@n앞으로는 조심해야겠군……@n실력 좋은 호위가 없어지니까.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:51",
   "src_sha1": "5764ef7db7a7",
   "ko": "……스카가 아직@n돌아다니고 있는 모양이에요.@n에드워드 군에게 들었어요.@n⊥@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:53",
   "src_sha1": "6e92e7e1326f",
   "ko": "……죽지 마세요.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:55",
   "src_sha1": "19c47b2ece85",
   "ko": "그래……고생시키는군.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:57",
   "src_sha1": "218035919f03",
   "ko": "사람을 잘못 따라온 건지도 모르겠어요.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:59",
   "src_sha1": "7d0104944cee",
   "ko": "……잘못됐다고 생각되면 쏴 죽여라.@n이슈발 이후, 내 부하로@n임명했을 때의 약속이다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:60",
   "src_sha1": "dba7b74c0473",
   "ko": "아직 허용 범위입니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:62",
   "src_sha1": "4477ec674a6a",
   "ko": "하하하……호크아이 중위는 상냥하군.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:64",
   "src_sha1": "52724683ba76",
   "ko": "……그럼, 대령님.@n⊥@n……또 뵙겠습니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:76",
   "src_sha1": "f25e57461936",
   "ko": "……일, 땡땡이치지 마세요.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:88",
   "src_sha1": "24d712d20886",
   "ko": "……이 방이@n이렇게 넓었던가…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:92",
   "src_sha1": "6749dbe3eacc",
   "ko": "폰도……@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:99",
   "src_sha1": "366599d51a97",
   "ko": "비숍도……@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:106",
   "src_sha1": "89f2199a995a",
   "ko": "룩도……@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:113",
   "src_sha1": "0cfbbf36b721",
   "ko": "나이트도……그리고,@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:118",
   "src_sha1": "ea93da113268",
   "ko": "……퀸도 빼앗겼다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:121",
   "src_sha1": "7bf634760c8b",
   "ko": "하지만 체크메이트라기엔……@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:128",
   "src_sha1": "7e8ddea57fd9",
   "ko": "……아직 이르다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:150",
   "src_sha1": "70e09cba39bc",
   "ko": "안녕하세요, 마담 크리스마스.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:151",
   "src_sha1": "e13d845395e4",
   "ko": "어머, 우리 로이, 오랜만이네.@n잘 지냈니?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:152",
   "src_sha1": "756656831254",
   "ko": "아휴, 기운 하나도 없어.@n영 아니야. 기분 좀 풀러 놀러 왔어.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:153",
   "src_sha1": "dad40cb9f811",
   "ko": "엘리자베스랑@n화끈하게 놀러 가면 되잖아.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:154",
   "src_sha1": "339a1b83b909",
   "ko": "엘리자베스는 다른 남자한테@n빼앗겨 버렸어요…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:155",
   "src_sha1": "aeae9e7587ef",
   "ko": "……뭐 마실래?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:156",
   "src_sha1": "b6419134f6aa",
   "ko": "막 나은 참이라, 술은 안 돼.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:166",
   "src_sha1": "dd55a632623f",
   "ko": "……특별한 걸로 부탁해.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:172",
   "src_sha1": "bb40954d5cb4",
   "ko": "어머, 이 술은 가게에 없는데.@n⊥@n……뭐, 금방 들여다 주겠지만.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A031_014_1:173",
   "src_sha1": "f37445899a05",
   "ko": "고마워, 마담…….@n⊿@n",
   "state": "draft",
   "flag": ""
  }
 ]
}