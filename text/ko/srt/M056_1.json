   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M056_1:32",
   "src_sha1": "446974bae8d3",
   "ko": "왜 그래?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M056_1:36",
   "src_sha1": "5b918d5a2211",
