{
 "source": "A045_010_1",
 "entries": [
  {
   "id": "srt:A045_010_1:15",
   "src_sha1": "93bd72797be0",
   "ko": "……음?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:16",
   "src_sha1": "7d1a02beeec7",
   "ko": "이런?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:28",
   "src_sha1": "1aeb48b1ca39",
   "ko": "이거 이거,@n암스트롱 소장 각하.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:34",
   "src_sha1": "3e32d61d7ee5",
   "ko": "……쳇!@n네놈이 센트럴 근무라니.@n⊥@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:40",
   "src_sha1": "4964086925d2",
   "ko": "……무슨 연줄을 썼지?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:41",
   "src_sha1": "bbb517cf7783",
   "ko": "글쎄요, 실력 아니겠습니까?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:47",
   "src_sha1": "dafd2d3aad31",
   "ko": "풋내기가 말은 잘하는군.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:49",
   "src_sha1": "a6543b81a33e",
   "ko": "……그래서, 오늘은@n무슨 용무로 오셨습니까?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:51",
   "src_sha1": "d6866ece4521",
   "ko": "대총통 각하께서 부르셔서 왔다.@n북쪽으로는 한동안 못 돌아갈지도@n모르겠군.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:53",
   "src_sha1": "dca53c3b5e41",
   "ko": "한동안 못 돌아가신다……@n그럼 꼭 한번 함께 식사라도.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:55",
   "src_sha1": "7d35e38cc6a9",
   "ko": "네가 사는 거냐?@n네놈이 파산할 때까지 먹어도@n된다면, 가 주지.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:61",
   "src_sha1": "120223149110",
   "ko": "……식사는 포기하겠습니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:63",
   "src_sha1": "e8eec102b7db",
   "ko": "뭐냐, 간도 지갑도@n작은 사내로군.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:65",
   "src_sha1": "a2606b9dc6ab",
   "ko": "그럼 대신 꽃이라도@n어떻겠습니까?@n⊥@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:67",
   "src_sha1": "bdd06a71876e",
   "ko": "……센트럴에는@n좋은 꽃집이 많으니까요.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:69",
   "src_sha1": "281f58ab8803",
   "ko": "……그런가.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:71",
   "src_sha1": "b34dfdef4cf9",
   "ko": "예, 그럼 이만.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:89",
   "src_sha1": "b0afdbb6be89",
   "ko": "……흥.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:109",
   "src_sha1": "dbcd712aebc8",
   "ko": "……들어오게.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:110",
   "src_sha1": "21a89ec7aa4c",
   "ko": "예!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:129",
   "src_sha1": "4d90c9ff8bf1",
   "ko": "…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:130",
   "src_sha1": "ad337ddaf4bc",
   "ko": "……자, 암스트롱 소장.@n레이븐 중장이 행방불명된 건에@n대해 묻겠네.@n⊥@n……무슨 짓을 했나?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:132",
   "src_sha1": "5d647b8ec776",
   "ko": "(……“무슨 짓을 했나”라.@n　이건 숨길 수 없겠군……)@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:134",
   "src_sha1": "05477b098797",
   "ko": "……각하.@n⊥@n각하 같은 분께서 그런@n덜렁이를 곁에 두고 계시다니@n어찌 된 일입니까?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:135",
   "src_sha1": "1024d672c35d",
   "ko": "……그래서 처리했나?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:137",
   "src_sha1": "4469722ae420",
   "ko": "필요 없지 않습니까, “그런 것”은.@n⊥@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:139",
   "src_sha1": "348074d25285",
   "ko": "그렇게 입이 가벼운 자가@n있어서는 각하께 도움이 되지@n않습니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:140",
   "src_sha1": "18cdc2daea6b",
   "ko": "……레이븐 중장은 자네에게@n무슨 말을 했나?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:142",
   "src_sha1": "5fef2c1917a8",
   "ko": "“불사의 군단”……@n“이 나라의 성립”……@n“호문쿨루스”……@n⊥@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:144",
   "src_sha1": "0be4dcf536ce",
   "ko": "그리고 각하의 정체…….@n묻지도 않은 것을 이것저것@n알려 주더군요.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:145",
   "src_sha1": "26db16c257cc",
   "ko": "흠……자네는 그걸 듣고서도@n내 호출에 응했다는 건가.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:147",
   "src_sha1": "cf2acac349db",
   "ko": "……예.@n그 멍청이가 앉아 있던@n자리를 물려받기 위해서.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:148",
   "src_sha1": "7910c5d46260",
   "ko": "후……@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:154",
   "src_sha1": "91edb8296185",
   "ko": "하하하하하!@n재미있군, 그래야……지!!@n⊥@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:160",
   "src_sha1": "8c252fef0dfe",
   "ko": "좋다, 자네에게 자리를 주지.@n대신 브릭스 요새는 내 수하가@n다스릴 텐데, 괜찮겠지?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:162",
   "src_sha1": "824b047ca924",
   "ko": "얼마든지, 뜻대로 하십시오.@n⊥@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:164",
   "src_sha1": "f9a7951c75f6",
   "ko": "정성 들여 키운@n굳센 병사들입니다.@n반드시 각하의 마음에 드실 겁니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:165",
   "src_sha1": "15352c3f310a",
   "ko": "마음에 들었다,@n올리비에 밀라 암스트롱.@n⊥@n끈질기게@n발버둥 쳐 봐라, 인간!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:167",
   "src_sha1": "4d90c9ff8bf1",
   "ko": "…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:185",
   "src_sha1": "610a7a6ec9a2",
   "ko": "“호랑이 굴에 들어가야@n　호랑이 새끼를 잡는다”@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:194",
   "src_sha1": "0625ef2209cf",
   "ko": "……소장님은 스스로@n호랑이 굴에 들어가신 겁니까.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:195",
   "src_sha1": "e17ffabeb14b",
   "ko": "그래.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:206",
   "src_sha1": "d9420e71b603",
   "ko": "……이곳도 곧@n그놈들 차지가 되겠지.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:207",
   "src_sha1": "5b146f448742",
   "ko": "……하지만 그놈들은@n브릭스 병사를 너무 모릅니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:216",
   "src_sha1": "2fe5e121f5d3",
   "ko": "진정한 주인이 없더라도@n하나의 의지 아래 움직일 수 있는@n거대한 한 덩어리의 바위……@n⊥@n그것이 브릭스 요새.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:217",
   "src_sha1": "86d044e03017",
   "ko": "그래……@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A045_010_1:225",
   "src_sha1": "c5106fa67926",
   "ko": "지금부터는@n호랑이와 곰이 서로 물어뜯는 거다!@n⊿@n",
   "state": "draft",
   "flag": ""
  }
 ]
}