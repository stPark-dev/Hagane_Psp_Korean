 "source": "F005_048_003",
 "entries": [
  {
   "id": "srt:F005_048_003:9",
   "src_sha1": "14ed88ea1056",
   "ko": "형이 없네……@n윈리도 없고.@n어디 간 걸까.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:10",
   "src_sha1": "bbb804b9ce6b",
   "ko": "어머, 알폰스 군.@n에드워드 군이라면 아까 공방 쪽에서@n졸고 있던 것 같은데?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:11",
   "src_sha1": "0201b99eabe5",
   "ko": "아, 고맙습니다.@n가 볼게요.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:19",
   "src_sha1": "1f75f8aa3131",
   "ko": "(형, 아직 자고 있나……)@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:22",
   "src_sha1": "4d90c9ff8bf1",
   "ko": "…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:23",
   "src_sha1": "a23d2bd4889f",
   "ko": "(아, 윈리다.@n 형 앞에서……뭐 하는 거지?)@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:28",
   "src_sha1": "df7958c68de6",
   "ko": "드르렁……쿨……@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:29",
   "src_sha1": "543244321d0c",
   "ko": "에드 녀석, 완전히 마음 놓은 것처럼@n잠들어서는, 태평하기도 하지.@n⊥@n…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:32",
   "src_sha1": "2a9cbd4906f3",
   "ko": "에잇, 에잇.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:33",
   "src_sha1": "85fbbe976bf2",
   "ko": "(이건……)@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:34",
   "src_sha1": "351d86c10eec",
   "ko": "형이 위험해!@n방해하면 안 돼……@n조금 더 지켜보자@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:40",
   "src_sha1": "fbda0f5001c9",
   "ko": "형이 위험해!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:58",
   "src_sha1": "ceeaa22ad1c2",
   "ko": "아, 알?!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:59",
   "src_sha1": "ce668ae1a720",
   "ko": "윈리, 형한테@n무슨 짓 하려고 했어?!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:61",
   "src_sha1": "49bc3a28a77c",
   "ko": "무슨 짓이라니, 난 자는 얼굴을……@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:67",
   "src_sha1": "4d5cfecb656e",
   "ko": "흠흠, 자는 얼굴을……@n그래서, 그래서?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:73",
   "src_sha1": "a2d859743e72",
   "ko": "……헉!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:79",
   "src_sha1": "dee1d935eceb",
   "ko": "알, 무슨 소리 하는 거야!!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:85",
   "src_sha1": "9022de0821c2",
   "ko": "헤헤헤……미안, 미안.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:87",
   "src_sha1": "7dc63b66ab75",
   "ko": "(방해하면 미안하니까,@n 나중에 다시 오자)@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:95",
   "src_sha1": "427ab2b3cd22",
   "ko": "왁!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:96",
   "src_sha1": "51fbd2bbe454",
   "ko": "꺅!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:104",
   "src_sha1": "f7dd67e7485f",
   "ko": "알?!@n뭐야, 언제부터 있었어?!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:110",
   "src_sha1": "3c0e53a99cb4",
   "ko": "아하하……미안.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:112",
   "src_sha1": "d55605ae367b",
   "ko": "(조금 더 지켜볼까)@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:113",
   "src_sha1": "53e4dafa5fa0",
   "ko": "에헤헤……이 녀석 자는 얼굴은@n의외로 귀엽단 말이야.@n깨어 있을 땐 시끄럽지만.@n⊥@n후훗.@n왠지 엄마가 된 기분이야.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:114",
   "src_sha1": "85a84a05ff0c",
   "ko": "(……윈리, 행복해 보이네)@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:122",
   "src_sha1": "427ab2b3cd22",
   "ko": "왁!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:123",
   "src_sha1": "51fbd2bbe454",
   "ko": "꺅!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:131",
   "src_sha1": "f7dd67e7485f",
   "ko": "알?!@n뭐야, 언제부터 있었어?!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:137",
   "src_sha1": "3c0e53a99cb4",
   "ko": "아하하……미안.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:139",
   "src_sha1": "de08db9b0073",
   "ko": "지, 지금 본 거, 에드한테는……!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:141",
   "src_sha1": "3327193df1c2",
   "ko": "물론 말 안 할게.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:147",
   "src_sha1": "f9ebd6b8c89a",
   "ko": "고, 고마워.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:164",
   "src_sha1": "b283a066e1af",
   "ko": "으~. 애초에 이 녀석이@n이런 얼굴로 자고 있으니까 나쁜 거야.@n왠지 화가 나기 시작했어!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:174",
   "src_sha1": "1adf1d491e20",
   "ko": "그건 생트집 같은데…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:180",
   "src_sha1": "d0ed635c30ec",
   "ko": "후후훗……@n두고 봐, 에드.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:195",
   "src_sha1": "99243b1e17a8",
   "ko": "윈리, 대체 뭘……?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:212",
   "src_sha1": "eddff847c0e8",
   "ko": "이걸로 됐다!@n음, 내가 봐도 센스 좋네.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:218",
   "src_sha1": "3708b118e050",
   "ko": "형……불쌍해라.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:220",
   "src_sha1": "e4a42822f4ab",
   "ko": "가자, 알.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:222",
   "src_sha1": "40442de3a14d",
   "ko": "으, 응…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:243",
   "src_sha1": "eadd965a85f1",
   "ko": "드르렁……쿨…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:258",
   "src_sha1": "b9b59a9950f3",
   "ko": "이런 화장이 있는 건가……@n이국의 문화는 재미있네.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:259",
   "src_sha1": "55c9432516eb",
   "ko": "……이건@n장난을 당하신 겁니다, 도련님.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:261",
   "src_sha1": "6dc458c2a0e8",
   "ko": "그런가?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:F005_048_003:283",
   "src_sha1": "019df3318a7a",
   "ko": "알과 윈리의 미니 드라마를@n입수했습니다. 타이틀 화면 또는@nGALLERY에서 들을 수 있습니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  }
 ]
