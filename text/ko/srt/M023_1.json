  {
   "id": "srt:M023_1:41",
   "src_sha1": "d7450c8fdf6f",
   "ko": "……너희 일로 상담받은 적이@n한 번도 없었으니까……놀랐어.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M023_1:43",
   "src_sha1": "8ea341753d85",
   "ko": "음……그렇구나.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M023_1:46",
   "src_sha1": "f7ab241e3f55",
   "ko": "……무서웠어.@n⊥@n휴즈 씨가 살해당할 만큼@n위험한 곳에서, 에드도 알도 계속@n싸우고 있다……그렇게 생각하니까.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M023_1:48",
   "src_sha1": "4d90c9ff8bf1",
