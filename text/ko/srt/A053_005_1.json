   "flag": ""
  },
  {
   "id": "srt:A053_005_1:193",
   "src_sha1": "d40d94dd85ce",
   "ko": "미안하다.@n그건 아마 “이전” 그리드일 거다@n⊥@n난 너를 몰라.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A053_005_1:194",
   "src_sha1": "b402c2a9a8c1",
