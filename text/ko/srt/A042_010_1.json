 "source": "A042_010_1",
 "entries": [
  {
   "id": "srt:A042_010_1:10",
   "src_sha1": "4d90c9ff8bf1",
   "ko": "…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:11",
   "src_sha1": "a5676ea38335",
   "ko": "각하!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:12",
   "src_sha1": "0baef000b903",
   "ko": "……배커니어인가.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:23",
   "src_sha1": "88ee7c3f5b6a",
   "ko": "……늦었군.@n뒈진 줄 알았다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:29",
   "src_sha1": "6fdc21a0abe8",
   "ko": "하하하.@n뒈지다 말았습니다.@n⊥@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:31",
   "src_sha1": "9bcab9201925",
   "ko": "구조한 놈들이 빛을 무서워해서요.@n랜턴을 끄고 움직일 수밖에@n없었습니다. 애먹었습니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:32",
   "src_sha1": "1f6d18541fda",
   "ko": "선견대 대원들은 무사했나?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:33",
   "src_sha1": "abdb4b396091",
   "ko": "간신히 두 명만.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:35",
   "src_sha1": "281f58ab8803",
   "ko": "……그런가.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:36",
   "src_sha1": "5b31db581709",
   "ko": "이런 곳에서 뭘 하고 계십니까?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:42",
   "src_sha1": "b79373295ce6",
   "ko": "……산을 보고 있었다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:47",
   "src_sha1": "4d1b8916b9a7",
   "ko": "……브릭스의 겨울은 좋군.@n흰색과 검은색밖에 없지.@n아주 명확해서 마음에 든다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:48",
   "src_sha1": "fc0dfeef1125",
   "ko": "…….@n⊥@n……그렇습니까?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:49",
   "src_sha1": "0a55235eb7ec",
   "ko": "?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:56",
   "src_sha1": "2733e595138a",
   "ko": "……올려다보면@n하늘의 파란색도 있습니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:57",
   "src_sha1": "4d90c9ff8bf1",
   "ko": "…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:58",
   "src_sha1": "77be15a8ac50",
   "ko": "……사람의 마음도 흰색과 검은색만은@n아니지요.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:61",
   "src_sha1": "7d5497355f6b",
   "ko": "이번 수색, 24시간을 넘겼을 때는@n통로도 막혀 있을 거라 생각하고@n있었습니다만……@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:72",
   "src_sha1": "91c7e35d940f",
   "ko": "24시간을 재기 위한 각하의@n이 시계……고장 나 있었던 덕분에@n목숨을 건졌습니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:86",
   "src_sha1": "3ebb5acea61f",
   "ko": "……이번에는@n자비를 베풀어 주셔서@n감사합니다.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:92",
   "src_sha1": "e991d1a5135f",
   "ko": "글쎄……@n무슨 소리인지 모르겠군.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:109",
   "src_sha1": "6f59a486987d",
   "ko": "음……뭔가 왔군요.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:110",
   "src_sha1": "b2b45c2ef078",
   "ko": "흥……생각보다 빨리 왔군.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:121",
   "src_sha1": "30ed11b0a9ca",
   "ko": "암스트롱 소장 각하!@n센트럴에서 온 전령입니다!@n⊥@n“레이븐 중장 실종 건에 관해@n 사정 청취를 위해 중앙사령부로@n 출두하라”는 내용입니다!@n⊥@n이미 이 요새로 중앙군의 사자와@n조사대가 향하고 있다고 합니다!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:127",
   "src_sha1": "9a1aff04b81e",
   "ko": "뭐라고!?@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:128",
   "src_sha1": "35d9195c5d62",
   "ko": "알았다, 곧 가지.@n⊥@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:134",
   "src_sha1": "5a613c32feff",
   "ko": "……배커니어, 뒷일은 맡기마.@n모르쇠로 버텨라. 알겠나.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:136",
   "src_sha1": "9f5a68fdd5a9",
   "ko": "……알겠습니다!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A042_010_1:137",
   "src_sha1": "4d90c9ff8bf1",
   "ko": "…….@n⊿@n",
   "state": "draft",
   "flag": ""
  }
 ]
}