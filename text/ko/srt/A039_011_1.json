   "src_sha1": "4d90c9ff8bf1",
   "ko": "…….@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:A039_011_1:285",
   "src_sha1": "13dca9b252b6",
   "ko": "……네.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
