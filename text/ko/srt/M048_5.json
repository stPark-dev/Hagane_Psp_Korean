   "flag": ""
  },
  {
   "id": "srt:M048_5:130",
   "src_sha1": "c820f0f5749f",
   "ko": "……잘 있거라.@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M048_5:131",
   "src_sha1": "7de72e85ca79",
   "ko": "거기 서세요, 스카!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M048_5:132",
   "src_sha1": "c3e71dd6ce76",
   "ko": "킴블리 씨, 위험합니다!@n건물에 다가가지 마십시오!@n무너집니다!!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
   "id": "srt:M048_5:147",
   "src_sha1": "32f89f95f720",
   "ko": "음……안 되겠군, 눈보라가 온다!@n전원, 철수!!@n⊿@n",
   "state": "draft",
   "flag": ""
  },
  {
